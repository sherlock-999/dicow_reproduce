#!/usr/bin/env bash
#PBS -N dicow_smoke
#PBS -P Personal
#PBS -q normal
# NSCC allocates at least 16 CPU cores and 110 GB RAM with one A100.
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/d230009/project/DiCoW_exp/dicow_reproduce/logs/pbs/dicow_smoke.scheduler.log

# Submit with: qsub scripts/train_smoke.pbs

set -euo pipefail

readonly REPO_DIR="/scratch/users/ntu/d230009/project/DiCoW_exp/dicow_reproduce"
readonly ENV_DIR="/home/users/ntu/d230009/miniconda3/envs/dicow-reproduce"
readonly JOB_ID="${PBS_JOBID:?This script must be submitted with qsub}"
readonly LOG_DIR="${REPO_DIR}/logs/smoke"
readonly OUTPUT_DIR="${REPO_DIR}/outputs/smoke/${JOB_ID}"
readonly LOG_FILE="${LOG_DIR}/${JOB_ID}.log"

mkdir -p "${LOG_DIR}" "${OUTPUT_DIR}"
exec > >(tee -a "${LOG_FILE}") 2>&1

cd "${REPO_DIR}"
source /home/users/ntu/d230009/miniconda3/etc/profile.d/conda.sh
conda activate "${ENV_DIR}"

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS="${PBS_NCPUS:-8}"

echo "Job: ${JOB_ID}"
echo "Host: $(hostname)"
echo "Started: $(date --iso-8601=seconds)"
echo "Log: ${LOG_FILE}"
echo "Output: ${OUTPUT_DIR}"
nvidia-smi -L

test -s whisper-large-v3-turbo/model.safetensors
test -s manifests/notsofar1_train_30s_ts.jsonl.gz

python - <<'PY'
import torch

assert torch.cuda.is_available(), "CUDA is unavailable"
assert torch.cuda.device_count() == 1, torch.cuda.device_count()
print("CUDA smoke preflight:", torch.cuda.get_device_name(0))
PY

python -m train.train \
    --config configs/debug.yaml \
    --mixed-precision no \
    --output-dir "${OUTPUT_DIR}"

echo "Finished: $(date --iso-8601=seconds)"
