#!/usr/bin/env bash
#PBS -N dicow_v1_train
#PBS -P Personal
#PBS -q normal
#PBS -l select=2:ncpus=64:ngpus=4:mem=400gb:mpiprocs=1
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/d230009/project/DiCoW_exp/dicow_reproduce/logs/pbs/dicow_v1_train.scheduler.log

# Submit with: qsub scripts/train_final.pbs
# Resume with:
#   qsub -v RESUME_CHECKPOINT=/absolute/path/to/checkpoint scripts/train_final.pbs

set -euo pipefail

readonly REPO_DIR="/scratch/users/ntu/d230009/project/DiCoW_exp/dicow_reproduce"
readonly ENV_DIR="/home/users/ntu/d230009/miniconda3/envs/dicow-reproduce"
readonly JOB_ID="${PBS_JOBID:?This script must be submitted with qsub}"
readonly LOG_DIR="${REPO_DIR}/logs/train"
readonly OUTPUT_DIR="${REPO_DIR}/outputs/dicow-v1-large-v3-turbo"
readonly LOG_FILE="${LOG_DIR}/${JOB_ID}.log"

mkdir -p "${LOG_DIR}" "${OUTPUT_DIR}"
exec > >(tee -a "${LOG_FILE}") 2>&1

cd "${REPO_DIR}"
source /home/users/ntu/d230009/miniconda3/etc/profile.d/conda.sh
conda activate "${ENV_DIR}"

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=8
export NCCL_DEBUG=WARN

echo "Job: ${JOB_ID}"
echo "Host: $(hostname)"
echo "Started: $(date --iso-8601=seconds)"
echo "Log: ${LOG_FILE}"
echo "Output: ${OUTPUT_DIR}"
pbsdsh -c 2 -- nvidia-smi -L

required_files=(
    whisper-large-v3-turbo/model.safetensors
    manifests/notsofar1_train_30s_ts.jsonl.gz
    manifests/ami-sdm_train_30s_ts.jsonl.gz
    manifests/libri2mix_100_noisy_30s_ts.jsonl.gz
    manifests/libri2mix_360_noisy_30s_ts.jsonl.gz
    manifests/libri3mix_360_noisy_30s_ts.jsonl.gz
    manifests/librispeechmix_train_3mix_ts.jsonl.gz
    manifests/notsofar1_dev1_30s_ts.jsonl.gz
)

for required_file in "${required_files[@]}"; do
    test -s "${required_file}"
done
test -d data/musan/noise

python - <<'PY'
import torch

assert torch.cuda.is_available(), "CUDA is unavailable"
assert torch.cuda.device_count() == 4, torch.cuda.device_count()
print("CUDA primary-node preflight:", [torch.cuda.get_device_name(i) for i in range(4)])
PY

mapfile -t hosts < <(sort -u "${PBS_NODEFILE:?PBS_NODEFILE is unavailable}")
if [[ "${#hosts[@]}" -ne 2 ]]; then
    echo "Expected two allocated GPU nodes, found ${#hosts[@]}: ${hosts[*]}" >&2
    exit 1
fi

readonly MASTER_ADDR="${hosts[0]}"
readonly MASTER_PORT="$((20000 + ${JOB_ID%%.*} % 20000))"
echo "Nodes: ${hosts[*]}"
echo "Distributed rendezvous: ${MASTER_ADDR}:${MASTER_PORT}"

if [[ -n "${RESUME_CHECKPOINT:-}" ]]; then
    test -d "${RESUME_CHECKPOINT}"
    echo "Resuming from: ${RESUME_CHECKPOINT}"
fi

launch_node() {
    local node_index="$1"
    local machine_rank="$2"

    pbsdsh -n "${node_index}" -- /usr/bin/env \
        REPO_DIR="${REPO_DIR}" \
        ENV_DIR="${ENV_DIR}" \
        OUTPUT_DIR="${OUTPUT_DIR}" \
        MASTER_ADDR="${MASTER_ADDR}" \
        MASTER_PORT="${MASTER_PORT}" \
        MACHINE_RANK="${machine_rank}" \
        RESUME_CHECKPOINT="${RESUME_CHECKPOINT:-}" \
        PYTHONUNBUFFERED=1 \
        TOKENIZERS_PARALLELISM=false \
        OMP_NUM_THREADS=8 \
        NCCL_DEBUG=WARN \
        /bin/bash -c '
            set -euo pipefail
            cd "${REPO_DIR}"
            train_args=(
                --config configs/dicow_v1.yaml
                --output-dir "${OUTPUT_DIR}"
            )
            if [[ -n "${RESUME_CHECKPOINT}" ]]; then
                train_args+=(--resume "${RESUME_CHECKPOINT}")
            fi
            exec "${ENV_DIR}/bin/accelerate" launch \
                --multi_gpu \
                --num_processes 8 \
                --num_machines 2 \
                --machine_rank "${MACHINE_RANK}" \
                --main_process_ip "${MASTER_ADDR}" \
                --main_process_port "${MASTER_PORT}" \
                -m train.train "${train_args[@]}"
        '
}

launch_node 0 0 &
rank_zero_pid=$!
launch_node 1 1 &
rank_one_pid=$!
wait "${rank_zero_pid}"
wait "${rank_one_pid}"

echo "Finished: $(date --iso-8601=seconds)"
