#!/usr/bin/env bash
#PBS -N dicow_nan_diag
#PBS -P Personal
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /scratch/users/ntu/d230009/project/DiCoW_exp/dicow_reproduce/logs/pbs/dicow_nan_diag.scheduler.log

set -euo pipefail

readonly REPO_DIR="/scratch/users/ntu/d230009/project/DiCoW_exp/dicow_reproduce"
readonly ENV_DIR="/home/users/ntu/d230009/miniconda3/envs/dicow-reproduce"
readonly JOB_ID="${PBS_JOBID:?This script must be submitted with qsub}"
readonly LOG_DIR="${REPO_DIR}/logs/diagnostics"
readonly LOG_FILE="${LOG_DIR}/${JOB_ID}.log"

mkdir -p "${LOG_DIR}"
exec > >(tee -a "${LOG_FILE}") 2>&1

cd "${REPO_DIR}"
source /home/users/ntu/d230009/miniconda3/etc/profile.d/conda.sh
conda activate "${ENV_DIR}"

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false

echo "Job: ${JOB_ID}"
echo "Host: $(hostname)"
echo "Started: $(date --iso-8601=seconds)"
nvidia-smi -L

python -m scripts.diagnose_nan

echo "Finished: $(date --iso-8601=seconds)"
